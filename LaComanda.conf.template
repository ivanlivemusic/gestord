# La Comanda - Template File di Configurazione
# www.ivanlivemusic.com
#
# Questo è un file template. Il file LaComanda.conf verrà generato
# automaticamente al primo avvio dell'applicazione.
# Copia questo file in LaComanda.conf per personalizzare la configurazione.

[admin_console]
# Posizione della finestra consolle amministrazione
x = 100
y = 100
width = 1000
height = 700
maximized = False

[kitchen_display]
# Posizione della finestra display cucina
x = 100
y = 100
width = 1024
height = 768
maximized = False

[qr_window]
# Posizione della finestra QR code
x = 200
y = 200
width = 500
height = 600
maximized = False

[Ngrok]
# Token di autenticazione Ngrok per accesso remoto
# Ottieni il tuo token da: https://dashboard.ngrok.com/get-started/your-authtoken
# IMPORTANTE: NON committare il token nel repository - aggiungerlo solo localmente
# Esempio: authtoken = YOUR_TOKEN_HERE
authtoken = 

[Reminders]
ci_timeout = 10
cd_timeout = 25
cd_prepared_timeout = 5
reminder_sound = true
auto_reminder_enabled = true
warning_threshold_percent = 0.8 
